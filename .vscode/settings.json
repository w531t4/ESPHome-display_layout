{
  "clangd.arguments": [
    "--compile-commands-dir=/home/vscode/.cache/.esphome/build/clangd/build",
    "--query-driver=/home/vscode/.cache/esphome/idf/tools/xtensa-esp-elf/*/xtensa-esp-elf/bin/xtensa-esp32-elf-*"
  ],
  "files.exclude": {
    "**/__pycache__/**": true,
    "config/components": true,
    "config/.esphome": true,
    ".esphome/**": true
  },
  "clangd.path": "/usr/bin/clangd",
  "files.associations": {
    "minimal_esphome.yaml": "esphome",
    "**/config/*.yaml": "esphome",
    "**/config/*.yml": "esphome"
  }
}
